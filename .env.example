# Placeholders only. Never commit your populated .env.
GOOGLE_API_KEY=

# Optional hosted PostgreSQL URLs; each overrides its local profile fallback.
# Use a provisioned read-only analyst_agent role and the required SSL options.
# Format: postgresql://<user>:<password>@<host>:5432/<database>?sslmode=require
DATABASE_SALES_URL=
DATABASE_SAAS_URL=

# Local development fallback. DB_NAME remains the CLI/evaluation default.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agentic_analyst
DB_USER=analyst_agent
DB_PASSWORD=

# Explicit browser origins, comma-separated; no wildcard or credentialed CORS.
ALLOWED_ORIGINS=http://localhost:5173

# Relative TRACE_DIR is resolved from the repository root.
TRACE_ENABLED=true
TRACE_DIR=runs
